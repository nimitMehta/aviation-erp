<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css" />
</head>
<body>
  <div class="main-container">
    <!-- Sidebar -->
    <aside class="sidebar">
      <div class="sidebar-header">
        <h2>Aviation ERP</h2>
      </div>
      <nav class="sidebar-menu">
        <ul>
          <li><a href="/"><i class="fas fa-home"></i> Home</a></li>
          <li class="submenu">
            <a href="#"><i class="fas fa-right-to-bracket"></i> Entries <i class="fas fa-chevron-down dropdown-icon"></i></a>
            <ul class="dropdown">
              <li><a href="/aircraft"><i class="fas fa-plane"></i> Aircraft</a></li>
              <li><a href="/crew"><i class="fas fa-user"></i> Crew</a></li>
            </ul>
          </li>
          <li><a href="/crew-rostering"><i class="fas fa-calendar-days"></i> Crew Rostering</a></li>
          <li class="submenu">
            <a href="#"><i class="fas fa-chart-bar"></i> Reports <i class="fas fa-chevron-down dropdown-icon"></i></a>
            <ul class="dropdown">
              <li><a href="/reports/daily"><i class="fas fa-calendar-day"></i> Daily</a></li>
              <li><a href="/reports/monthly"><i class="fas fa-calendar-alt"></i> Monthly</a></li>
            </ul>
          </li>
        </ul>
      </nav>
      <div class="sidebar-footer">
        <form action="/logout" method="POST">
          <button type="submit" class="logout-btn"><i class="fas fa-sign-out-alt"></i> Logout</button>
        </form>
      </div>
    </aside>

    <!-- Main Content -->
    <div class="content">
      <header class="content-header">
        <h1><%= title %></h1>
      </header>
      <main class="content-body">
        <%- body %>
      </main>
    </div>
  </div>
</body>
</html>
